; Godot 4 prosjektfil for SANITY SHOOTER.
; Redigeres normalt gjennom editoren, men er ren tekst og trygg i git.

config_version=5

[application]

config/name="Sanity Shooter"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation="landscape"

[input_devices]

; Av: dette er kun til musetesting på PC. På en telefon med ekte
; berøringsskjerm er det bare en ekstra kilde til dobbel input.
pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
